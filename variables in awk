#Built-in string functions
length(str)
Return length of string or array
awk '{print length($1)}' file

substr(str,s,n)
Extract substring starting at position s, length n
awk '{print substr($1,1,3)}' file

index(str,find)
Find position of substring in string. 0 if not found
awk '{print index($0,"error")}' file

split(str,arr,sep)
Split string into array by separator
awk '{split($1,a,"."); print a[1]}' file

sub / gsub
sub=replace first match. gsub=replace ALL matches
awk '{gsub(/error/,"ERROR"); print}' file

tolower / toupper
Convert string to lowercase / uppercase
awk '{print tolower($0)}' file

sprintf(fmt,...)
Format string like printf but returns it as string
awk '{s=sprintf("%.2f",$3); print s}' file

match(str,regex)
Returns position of regex match. Sets RSTART RLENGTH
awk '{if(match($0,/[0-9]+/)) print RSTART}' f
Built-in math functions

int / sqrt
Integer truncation / square root
awk '{print int($3/1024)"KB"}' file

log / exp
Natural log / e raised to power
awk '{print log($3)}' file

rand / srand
Random number 0-1 / seed random number generator
awk 'BEGIN{srand(); print rand()}'

printf fmt
Formatted output like C printf. %s=string %d=int %f=float
awk '{printf "%-10s %5.2f\n",$1,$3}'
User-defined functions
  awk 'function max(a,b){return a>b?a:b} {print max($2,$3)}' file
Define your own function — max() here returns larger of two values
awk 'function toMB(b){return b/1024/1024} {print $1, toMB($3)"MB"}' file
Custom function to convert bytes to megabytes — reusable in awk script
